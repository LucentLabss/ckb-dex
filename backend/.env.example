MONGO_DB_URL=mongodb://127.0.0.1:27017/?directConnection=true&serverSelectionTimeoutMS=2000&appName=ckd-dex
NODE_ENV=development
PORT=3000
CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckb.dev
# Required, at least 32 characters. Generate with: openssl rand -hex 32
INTERNAL_BOT_TOKEN=
# Blocks a transaction must be buried under before the backend indexes it (reorg safety).
CONFIRMATION_DEPTH=10
