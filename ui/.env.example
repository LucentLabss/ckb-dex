# Optional. Copy to .env.local only to override a default. Only VITE_* vars
# reach the browser bundle.
#
# The dapp runs on CKB testnet. The DEX contract, xUDT script and market token
# come from ckb-dex/deployment/manifest.json. By default it uses the deployed
# backend and faucet, so nothing below is required.

# ckb-dex backend REST base URL and WebSocket origin.
# Default: https://api.72.62.119.247.sslip.io/api/v1 and wss://api.72.62.119.247.sslip.io
VITE_API_URL=
VITE_WS_URL=

# xUDT faucet service. Default: https://faucet.72.62.119.247.sslip.io/api/v1/faucet
VITE_FAUCET_URL=

# CKB testnet RPC the browser talks to directly. Default: https://testnet.ckb.dev
VITE_CKB_RPC_URL=

# Display decimals for the market token (the manifest doesn't define any). Default: 0
VITE_XUDT_DECIMALS=
