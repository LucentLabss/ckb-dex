# Backend REST base URL (see backend/.env.example PORT/API_VERSION).
VITE_API_URL=http://localhost:3000/api/v1

# Backend WebSocket origin (RealtimeBroadcaster attaches to the same HTTP server,
# so this is normally the API host without the /api/v1 path).
VITE_WS_URL=ws://localhost:3000

# CKB RPC node. In dev this only configures the vite proxy target at /api/ckb-rpc
# (see vite.config.ts) so the browser avoids the node's missing CORS headers; the
# app itself always talks to /api/ckb-rpc in dev. In a production build, set this to
# a publicly reachable RPC URL (with CORS enabled) and it's used directly.
VITE_CKB_RPC_URL=http://127.0.0.1:28114

# Which bucket of deployment/scripts.json to read the dex-order-lock deployment from.
VITE_DEX_NETWORK=devnet

# Lock hash of whoever ran offchain/src/issue-token.ts (the xUDT issuer). The demo
# token's args are issuerLockHash + 4 zero bytes - see offchain/src/issue-token.ts.
# Required to place or cancel real orders; without it the UI stays in read-only demo mode.
VITE_XUDT_ISSUER_LOCK_HASH=

# DEV ONLY - never set this to a key holding real funds, and never commit it. JoyID (and
# most hosted/extension wallets) can't represent a local devnet identity, so this lets local
# testing connect with a plain private key instead - e.g. offchain/.env's MAKER_PRIVATE_KEY,
# which already holds devnet CKB and demo tokens after running issue-token.ts. Ignored outside
# `vite dev` (import.meta.env.DEV) - never bundled into a production build.
VITE_DEV_PRIVATE_KEY=
